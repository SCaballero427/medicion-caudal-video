[Unit]
Description=STIV en tiempo real (velocidad superficial del rio)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=__USUARIO__
WorkingDirectory=__RAIZ__
EnvironmentFile=__RAIZ__/raspberry/stiv.conf
Environment=PYTHONUNBUFFERED=1
# $STIV_ARGS sin llaves: systemd lo parte en palabras, una por argumento
ExecStart=__RAIZ__/.venv/bin/python __RAIZ__/stiv_directo.py --sin-ventana $STIV_ARGS
# si el programa termina (video de prueba acabado, camara caida, sin red) vuelve a lanzarlo
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
